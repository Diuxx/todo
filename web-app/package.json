{
  "name": "todo",
  "version": "1.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:sync": "npm run build && npx cap sync",
    "android:assemble:release": "node scripts/android-assemble-release.js",
    "android:assemble:release:signed": "node scripts/android-assemble-release.js --signed",
    "apk:release": "npm run build:sync && npm run android:assemble:release",
    "apk:release:signed": "npm run build:sync && npm run android:assemble:release:signed",
    "version:set": "node scripts/set-version.js",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.js\" \"*.{md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.js\" \"*.{md,json}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.0",
    "dexie": "^4.4.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@angular/compiler-cli": "^20.3.18",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3"
  }
}
